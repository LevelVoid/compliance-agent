# config
cp .env.example .env

# LLM endpoint (OpenAI-compatible, e.g. a JarvisLabs serverless deployment)
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-model-id

# Use the deterministic stand-in instead of a real model (no network)
MOCK_LLM=0

# notification transport: outbox | slack | webhook
NUDGEBEE_MODE=outbox
SLACK_WEBHOOK_URL=
NUDGEBEE_WEBHOOK_URL=

# ingestion
MAX_FILES=12
