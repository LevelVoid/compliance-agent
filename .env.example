# config
cp .env.example .env

# LLM endpoint (OpenAI-compatible). Base URL should end in /v1.
# JarvisLabs Token Factory: set LLM_API_KEY to JARVISLABS_API_KEY — an endpoint
# and model id alone will 401. Self-hosted vLLM can leave the key empty.
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=
LLM_MODEL=your-model-id

# Use the deterministic stand-in instead of a real model (no network)
MOCK_LLM=0

# notification transport: outbox | slack | webhook
NUDGEBEE_MODE=outbox
SLACK_WEBHOOK_URL=
NUDGEBEE_WEBHOOK_URL=

# ingestion
MAX_FILES=12

# API server
# CORS_ORIGIN=http://localhost:3000   # adjust if the frontend runs on a different port
